APP_NAME=BlueDome
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Casablanca

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=blue_dome
DB_USERNAME=sail
DB_PASSWORD=password

# Non-BYPASSRLS role used by the pgsql_testing_a / pgsql_testing_b connections
# so the RLS isolation suite (tests/Rls/) can observe real policy enforcement.
# Provision once on the dev/test database:
#   CREATE ROLE blue_dome_app LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS;
#   GRANT USAGE ON SCHEMA public TO blue_dome_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE, TRUNCATE ON ALL TABLES IN SCHEMA public TO blue_dome_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO blue_dome_app;
#   GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO blue_dome_app;
DB_TEST_USERNAME=blue_dome_app
DB_TEST_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bluedome.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp Cloud API — populated per-clinic via whatsapp_integration table; these
# are app-wide defaults / fallbacks only.
# WHATSAPP_GRAPH_API_VERSION=v20.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Sentry (production observability — Phase 9 §devops). To enable:
#   1. composer require sentry/sentry-laravel  (gated by ops approval)
#   2. php artisan sentry:publish --dsn=<your-dsn>
#   3. Set SENTRY_LARAVEL_DSN below
# The Phase 9 bootstrap (bootstrap/app.php withExceptions block) calls the
# Sentry reporter when the package is installed AND the DSN is set; absent
# either, exception handling falls through to Laravel's default channel
# stack so dev/test environments stay quiet.
# SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_PROFILES_SAMPLE_RATE=0.05
# SENTRY_SEND_DEFAULT_PII=false

VITE_APP_NAME="${APP_NAME}"
